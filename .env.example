# Creature Evolution Lab is fully local-first. No environment variables are
# required to run, build, or test the app.
#
# The optional cloud leaderboard/gallery adapter (not enabled by default) would
# read the values below. Leave them blank for local-only operation. Never commit
# real secrets.

# VITE_CLOUD_ADAPTER=none            # none | supabase
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
